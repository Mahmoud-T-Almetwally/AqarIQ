# RealEstateAnalysis — environment template.
# Copy to `.env` for local development (`.env` is git-ignored).
# In production (Render) and CI (GitHub Actions) these are injected as
# real environment variables; names match the flat Settings fields in
# src/core/config.py.

# ── Application ────────────────────────────────────────────────────────────
# local | test | production  (aliases accepted: dev/development/ci/prod)
ENVIRONMENT=local
# Leave unset to derive: debug on locally, off in production.
#DEBUG=false
LOG_LEVEL=INFO
# Force JSON logs regardless of environment (optional).
#LOG_JSON=false

# Signing key for tokens the API issues (required in production).
SECRET_KEY=
# Shared secret for /internal/* endpoints used by GitHub Actions (§5).
INTERNAL_API_SECRET=
# Comma-separated list of allowed browser origins (web/ on Vercel).
CORS_ORIGINS=http://localhost:3000

# ── Database — Neon Postgres (Tier 2) ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=false
# Guardrail for LLM-proposed SQL (§5).
DB_STATEMENT_TIMEOUT_MS=5000

# ── Cache — Upstash Redis (Tier 4) ─────────────────────────────────────────
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379
REDIS_KEY_PREFIX=rea
# Exact-match response cache TTL, seconds (§5).
RESPONSE_CACHE_TTL_SECONDS=3600

# ── Message queue — CloudAMQP (Stage 2) ────────────────────────────────────
# AMQP_URL is preferred; CLOUDAMQP_URL (injected by Render) is the fallback.
AMQP_URL=amqps://user:password@XXXX.cloudamqp.com/user
ETL_QUEUE_NAME=etl.listings
ETL_DLQ_NAME=etl.listings.dlq
MQ_PREFETCH_COUNT=10
# Alert threshold under CloudAMQP's 20k queued-message cap (§8).
QUEUE_DEPTH_ALERT_THRESHOLD=5000

# ── LLM providers (§4) ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Chat synthesis failover chain (llm/pool.py): primary → fallback → Groq.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# ETL feature extraction + chat fallback 2.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Jev intent-router provider (vLLM-SR). Exactly one key; never commit it.
SR_API_KEY=
SR_BASE_URL=
SR_ROUTER_MODEL=vllm-sr/d3-ultra

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Matryoshka truncation for pgvector halfvec (§4).
EMBEDDING_DIMENSIONS=768

# ── Object lake — Neon Object Storage, S3-compatible (Tier 1) ──────────────
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Abuse protection (§5) ──────────────────────────────────────────────────
RATE_LIMIT_MESSAGES_PER_HOUR=10
RATE_LIMIT_MESSAGES_PER_DAY=20
